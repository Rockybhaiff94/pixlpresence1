generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  username      String    @unique
  globalName    String?
  avatar        String?
  banner        String?
  email         String?   @unique
  passwordHash  String?
  role          String    @default("USER") // USER, ADMIN
  badges        String    @default("[]")   // JSON string of badge IDs/names
  nitroStatus   Int       @default(0)      // 0: None, 1: Classic, 2: Nitro
  premiumStatus Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sessions      Session[]
  auditLogs     AuditLog[]
  richPresence  RichPresence?
  templates     ActivityTemplate[]
  layers        ProfileLayer[]
  identities    UserIdentity[]
  appToken      String?   @unique
}

model UserIdentity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // "discord" | "google" | "local"
  providerUserId  String   // Discord ID, Google sub, or email
  email           String?
  displayName     String?
  avatarUrl       String?
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerUserId])
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Customization
  displayName    String?
  bio            String?
  avatarUrl      String?
  bannerUrl      String?
  themeId        String?
  accentColor    String?
  musicUrl       String?
  particles      String?
  blur           Int      @default(0)
  opacity        Int      @default(100)
  roundedCorners Int      @default(10)

  // Status & Presence
  status         String   @default("ONLINE") // ONLINE, IN_GAME, AWAY, OFFLINE
  customStatus   String?
  currentGame    String?
  visibility     String   @default("PUBLIC") // PUBLIC, PRIVATE, UNLISTED
  profileVersion Int      @default(1)

  // Social & Buttons
  links          Link[]
  buttons        Button[]

  // Analytics
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Link {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  url       String
  label     String
  icon      String?
  color     String?
  animation String?
  visibility Boolean @default(true)
  order     Int      @default(0)
}

model Button {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  title     String
  subtitle  String?
  url       String
  icon      String?
  gradient  String?
  animation String?
  hoverEffect String?
  openInNewTab Boolean @default(true)
  order     Int      @default(0)
}

model RichPresence {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  appName         String?
  appId           String?
  state           String?
  details         String?
  largeImage      String?
  smallImage      String?
  largeImageText  String?
  smallImageText  String?
  startTimestamp  DateTime?
  endTimestamp    DateTime?
  partySize       Int?
  partyMax        Int?
  
  button1Label    String?
  button1Url      String?
  button2Label    String?
  button2Url      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityTemplate {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isGlobal        Boolean  @default(false)
  
  name            String
  category        String
  config          String   // JSON string of RichPresence data
  
  createdAt       DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  targetId  String?
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  timestamp DateTime @default(now())
}

model GuildConfiguration {
  id              String   @id @default(cuid())
  guildId         String   @unique
  theme           String?
  embedColor      String?  @default("#8b5cf6")
  footer          String?
  profileChannel  String?
  allowedChannels String   @default("[]") // JSON string of channel IDs
  featureSettings String   @default("{}") // JSON string of settings
  authorizedRoles String   @default("[]") // JSON string of role IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProfileLayer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layerType     String   // background, image, video, text, icon, button, overlay
  configuration String   // JSON string of properties
  order         Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SynchronizationEvent {
  id             String    @id @default(cuid())
  eventType      String
  entityId       String
  version        Int       @default(1)
  payload        String    // JSON string
  deliveryStatus String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
}
