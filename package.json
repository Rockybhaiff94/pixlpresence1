{
  "name": "discord-rpc-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:backend": "npm run generate --workspace=@discord-rpc/database && npm run db:push --workspace=@discord-rpc/database && npm run build --workspace=@discord-rpc/database && npm run build --workspace=api",
    "dev": "turbo run dev",
    "start": "npm start --workspace=api",
    "start:api": "npm start --workspace=api",
    "start:bot": "npm start --workspace=bot",
    "start:dev": "turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.10.3"
  }
}
