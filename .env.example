# ==============================================================================
# Pixel.gg Ecosystem – Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real credentials to Git.

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled database connection string (used by Prisma Client in production/runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection string (used by Prisma CLI for migrations/generation)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Central Backend & API (Express + Socket.IO + Discord Bot)
# ------------------------------------------------------------------------------
# Node runtime environment (development | production | test)
NODE_ENV="development"

# Port on which the central API listens (defaults to 3001 locally, 10000 on Render)
PORT=3001

# Strong cryptographic secret for signing session cookies
SESSION_SECRET="generate-a-secure-random-64-character-string-here"

# Allowed frontend origin for CORS, cookies, and OAuth redirects
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Discord OAuth2 & Bot Authentication
# ------------------------------------------------------------------------------
# Discord Application Client ID (from Discord Developer Portal)
DISCORD_CLIENT_ID="your_discord_client_id"

# Discord Application Client Secret (from Discord Developer Portal)
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# OAuth2 redirect URI configured in Discord Developer Portal
# Production: https://pixelgg-api.onrender.com/auth/discord/callback
# Local:      http://localhost:3001/auth/discord/callback
DISCORD_CALLBACK_URL="http://localhost:3001/auth/discord/callback"

# Discord Bot Token for Gateway connection and slash command registration
DISCORD_BOT_TOKEN="your_discord_bot_token"

# Optional bot presence customizations
BOT_ACTIVITY_NAME="Pixel.gg Profiles"
BOT_ACTIVITY_TYPE="WATCHING"
BOT_STATUS="online"

# ------------------------------------------------------------------------------
# 4. Frontend Website (Next.js on Vercel)
# ------------------------------------------------------------------------------
# Publicly accessible Central Backend API URL used by browser clients
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Internal/Server-side API URL used by Next.js Server Components
INTERNAL_API_URL="http://localhost:3001"

